{
  "name": "algomine",
  "version": "0.2.0",
  "private": true,
  "description": "A Minecraft-inspired interactive playground for data structures and algorithms.",
  "type": "module",
  "scripts": {
    "dev": "node scripts/serve.mjs",
    "start": "node scripts/serve.mjs",
    "test": "node --test \"tests/**/*.test.mjs\"",
    "format": "prettier --write \"dist/**/*.{js,mjs,css,html}\" \"tests/**/*.mjs\" \"scripts/*.mjs\"",
    "lint": "prettier --check \"dist/**/*.{js,mjs,css,html}\" \"tests/**/*.mjs\" \"scripts/*.mjs\"",
    "check": "node scripts/check.mjs"
  },
  "engines": { "node": ">=22" },
  "devDependencies": { "prettier": "^3.3.0" }
}
